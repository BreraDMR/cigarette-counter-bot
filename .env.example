# Bot token from @BotFather
BOT_TOKEN=put-your-telegram-bot-token-here

# Timezone the smoke breaks are stamped in (e.g. Europe/Prague, Europe/Kyiv, UTC)
TZ=Europe/Prague

# Paths inside the container - no reason to change these
DB_PATH=/data/cigarettes.db
PHOTO_DIR=/data/photos

# How long a fetched exchange rate is considered fresh, in hours.
# The numbers are approximate anyway, so twice a day is plenty.
RATES_TTL_HOURS=12
